# ----------------------------------------------------------------------------
# Local development (.env)
# ----------------------------------------------------------------------------
PORT=4000
DATABASE_URL=postgres://elite_user:elite_password@localhost:5432/elite_timesheet
# Use DATABASE_URL=memory to run against the in-memory mock database instead.
JWT_SECRET=super_secret_jwt_key_for_local_dev
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Railway (set these in the service's Variables tab, not in this file)
# ----------------------------------------------------------------------------
# NODE_ENV=production
#   Required. Without it the app falls back to the placeholder JWT secret above
#   and skips session-id enforcement.
#
# NPM_CONFIG_INCLUDE=dev
#   Required. NODE_ENV=production makes npm skip devDependencies, which would
#   leave the build without typescript and vite.
#
# DATABASE_URL=${{Postgres.DATABASE_URL}}
#   Reference the Railway Postgres service. TLS is disabled automatically for
#   *.railway.internal hosts; set DB_SSL=true to force it on.
#
# JWT_SECRET=<64 hex chars>          openssl rand -hex 32
# ENCRYPTION_KEY=<64 hex chars>      openssl rand -hex 32   (Xero token storage)
# REQUIRE_SESSION_ID=true            enforce server-side sessions on every request
#
# PLATFORM_ADMIN_EMAIL=you@example.com
# PLATFORM_ADMIN_PASSWORD=<8+ chars, letter + digit>
#   Used once, on the first boot against an empty database, to create the
#   initial Platform Admin. Sign in at /platform-gate.
#
# SEED_DEMO_ORG=true                 also create a demo org + Company Admin
# DEMO_ORG_NAME=Demo Organisation
# DEMO_ADMIN_EMAIL=demo-admin@example.com
# DEMO_ADMIN_PASSWORD=<8+ chars, letter + digit>
#
# Email (invitations, password resets, 2FA codes) - optional
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Elite Timesheet <noreply@yourdomain.com>
#
# Xero - optional, OAuth token exchange is not implemented yet
# XERO_CLIENT_ID=
# XERO_REDIRECT_URI=https://<your-app>.up.railway.app/api/xero/callback
