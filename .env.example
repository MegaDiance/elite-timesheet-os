# ----------------------------------------------------------------------------
# Local development (.env)
# ----------------------------------------------------------------------------
PORT=4000
# PostgreSQL only. Start the local database with:  docker compose up -d db
DATABASE_URL=postgres://elite_user:elite_password@localhost:5432/elite_timesheet
JWT_SECRET=super_secret_jwt_key_for_local_dev
# Base URL used in emailed links (sign-up, invitations, password reset, sign-in verification).
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Development prints emails (with their one-time links) to the server console.
EMAIL_PROVIDER=mock
# Email is off for the MVP: invitations and password resets fall back to a link the Owner copies
# and shares themselves; the suspicious-login and 2FA email steps are skipped rather than
# blocking sign-in. Set to true once a real EMAIL_PROVIDER is ready to use.
EMAIL_ENABLED=false

# Optional: create a first organisation and its Owner on an empty database (see backend/src/scripts/bootstrap.ts).
# SEED_OWNER_EMAIL=owner@example.com
# SEED_OWNER_PASSWORD=<8+ chars, letters and digits>
# SEED_ORGANISATION_NAME=Demo Organisation

# ----------------------------------------------------------------------------
# Railway (set these in the service's Variables tab, not in this file)
# ----------------------------------------------------------------------------
# NODE_ENV=production
# NPM_CONFIG_INCLUDE=dev             npm would otherwise skip typescript/vite at build time
# DATABASE_URL=${{Postgres.DATABASE_URL}}
#   TLS is disabled automatically for *.railway.internal hosts; DB_SSL=true forces it on.
# JWT_SECRET=<64 hex chars>          openssl rand -hex 32
# PUBLIC_URL=https://<your-app>.up.railway.app
# TRUST_PROXY=1                      default in production (Railway adds one proxy hop)
#
# Email (leave EMAIL_ENABLED=false for the MVP; set to true once these are ready)
# EMAIL_ENABLED=true
# EMAIL_PROVIDER=smtp                or resend / postmark
# EMAIL_FROM=SimpleHours <noreply@yourdomain.com>
#
# SMTP (generic mailbox, e.g. your domain host's outgoing mail server)
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587                      587 for STARTTLS, 465 for implicit TLS
# SMTP_SECURE=tls                    'ssl' for port 465, otherwise leave as 'tls'
# SMTP_USERNAME=noreply@yourdomain.com
# SMTP_PASSWORD=<mailbox password>   EMAIL_FROM should match this mailbox's domain
#
# Resend / Postmark (alternative HTTP API providers, still supported)
# RESEND_API_KEY=re_xxxxxxxx         or POSTMARK_SERVER_TOKEN=...
